# Local quick start (no Docker): sqlite. Production: the postgresql URL below.
DATABASE_URL=sqlite:///./marketing.db
# DATABASE_URL=postgresql+psycopg://marketing:marketing@localhost:5432/marketing_os
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PROVIDER=anthropic   # anthropic | fake
STORAGE_DIR=./var/storage
DESIGN_PROVIDER=auto   # auto (Chromium if installed, otherwise built-in Pillow) | pillow | canva
ENCRYPTION_KEY=        # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8000/api/v1/canva/callback
# CANVA_TEMPLATE_MAP={"offer_square":{"brand_template_id":"...","fields":{"headline":"HEADLINE","cta":"CTA"}}}
# Meta (Facebook Pages + Instagram), app in Development mode. Guide: docs/meta-setup-ar.md
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/callback
# META_CONFIG_ID=      # only if your app uses "Facebook Login for Business"
# PUBLIC_BASE_URL=     # public https URL of this server (needed for Instagram images)
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts   # trim to what your app has enabled
# LinkedIn company page. Guide: docs/linkedin-setup-ar.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback
# LINKEDIN_API_VERSION=202510
# LINKEDIN_SCOPES=r_organization_social w_organization_social rw_organization_admin
